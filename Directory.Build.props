<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!-- Strict null analysis: reference types are non-nullable by default and a
         possible null is a compile error. Nullability is opt-in via `string?`. -->
    <Nullable>enable</Nullable>

    <!-- Namespaces are declared explicitly in each project's GlobalUsings.cs
         rather than injected invisibly by the SDK. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unused usings) to run during build, not just in
         the IDE. Test projects suppress the resulting CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Every security rule, not just the recommended subset. `recommended`
         leaves most of the CA3xxx injection and CA5xxx cryptography rules off,
         which is the wrong default for a library that parses responses from a
         remote service. Combined with TreatWarningsAsErrors, a security finding
         fails the build rather than joining a warning list nobody reads.

         The shipped library goes further still — AnalysisMode=All + SonarAnalyzer
         — in TcgDex.CSharpSdk.csproj. That strictness is scoped to the code that
         ships rather than applied here, because on the test and benchmark
         projects those rules are almost entirely noise. -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>

    <!-- Fail restore on a dependency with a known advisory. `all` covers
         transitive packages too, which is where this realistically bites: the
         netstandard2.0 target pulls a 8.0.x dependency graph that the modern
         targets get in-box and therefore service automatically. `low` reports
         everything rather than only the alarming ones. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
