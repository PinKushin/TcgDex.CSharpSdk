<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hits the live TCGdex API. Every test here carries [Category("Integration")]
       so a TestCategory=Integration filter selects exactly this set. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TcgDex.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- CA1707: test names follow {Method}_{Scenario}_{Expected}, so the
         underscores are the convention, not a violation of it.
         CS1591: tests are not public API and carry no XML docs.
         CA1062: tests control their own inputs.
         CA2007: NUnit runs without a synchronization context, so ConfigureAwait
         adds noise without changing behaviour. It stays enforced in the SDK. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1062;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" />
  </ItemGroup>

</Project>
