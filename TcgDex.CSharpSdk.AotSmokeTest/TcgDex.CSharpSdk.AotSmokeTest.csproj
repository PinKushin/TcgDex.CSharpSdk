<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes with Native AOT and exercises the SDK, so the AOT-compatibility
       claim is demonstrated rather than inferred from analyzer silence. Any
       reflection or runtime codegen creeping into the SDK fails here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TcgDex.AotSmokeTest</RootNamespace>
    <IsPackable>false</IsPackable>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Surface trim and AOT problems as build errors rather than warnings. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- A smoke-test entry point is not public API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" />
  </ItemGroup>

</Project>
