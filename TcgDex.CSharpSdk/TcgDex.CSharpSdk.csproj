<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TcgDex</RootNamespace>
    <AssemblyName>TcgDex.CSharpSdk</AssemblyName>
  </PropertyGroup>

  <!-- Trim- and AOT-safety. The JSON layer is source-generated, so no
       reflection-based serialization is rooted at runtime. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <PackageId>TcgDex.CSharpSdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>PinKushin</Authors>
    <Description>A .NET SDK for the TCGdex Pokemon TCG API - strongly typed models, a fluent query builder over the full REST filter syntax, and opt-in GraphQL for projection and nested fetches.</Description>
    <PackageTags>tcgdex;pokemon;tcg;trading-card-game;api-client;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/PinKushin/TcgDex.CSharpSdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/PinKushin/TcgDex.CSharpSdk</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- net10.0 ships System.Text.Json in the shared framework; net8.0 needs the
       package to pick up the same source-generator behaviour. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
