<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TcgDex</RootNamespace>
    <AssemblyName>TcgDex.CSharpSdk</AssemblyName>
  </PropertyGroup>

  <!-- Trim- and AOT-safety. The JSON layer is source-generated, so no
       reflection-based serialization is rooted at runtime.

       net6.0+ only: trimming and AOT do not exist on netstandard2.0, and
       IsAotCompatible there raises NETSDK1210. The analyzers still run on the
       modern targets, which compile the same source, so netstandard2.0 gets the
       benefit of the discipline without being able to declare it. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <PackageId>TcgDex.CSharpSdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>PinKushin</Authors>
    <Description>A .NET SDK for the TCGdex Pokemon TCG API - strongly typed models, a fluent query builder over the full REST filter syntax, and opt-in GraphQL for projection and nested fetches.</Description>
    <PackageTags>tcgdex;pokemon;tcg;trading-card-game;api-client;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      A link rather than the notes themselves: release notes pasted in here have
      to be edited every release and are the first thing to go stale, whereas
      this URL is correct for every version without being touched.
    -->
    <PackageReleaseNotes>See https://github.com/PinKushin/TcgDex.CSharpSdk/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/PinKushin/TcgDex.CSharpSdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/PinKushin/TcgDex.CSharpSdk</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Supplied by the shared framework on net8.0+; packages here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <!-- System.Text.Json is deliberately NOT referenced as a package. Both
       targets ship it in the shared framework, including the source generator,
       and it is serviced with the runtime — so a consumer picks up security
       fixes by patching .NET rather than by us bumping a dependency. Adding the
       reference back raises NU1510 on net8.0. -->

</Project>
