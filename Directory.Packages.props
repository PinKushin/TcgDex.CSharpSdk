<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies of the SDK, one release line per target framework
       (DECISIONS #17). Every line tracks its NEWEST patch: these updates are
       security, features and performance. This is not a minimum-version policy.

       net10.0 is on the 10.x line. net8.0 and netstandard2.0 stay on 8.0.x,
       because putting 10.x there would force ASP.NET Core 8 apps onto the 10.x
       Microsoft.Extensions graph and conflict with their pinned 8.0.x.
       netstandard2.0 exists for compatibility (Unity, .NET Framework, older
       Windows), not to hold anything back.

       Conditioned on net10.0 alone, so every other TFM, including the net472
       test leg, resolves the 8.0.x line that netstandard2.0 consumers actually
       get. DependencyLineTests asserts this per leg. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>

  <!-- netstandard2.0 has no in-box System.Text.Json, no IAsyncEnumerable, and
       no ActivitySource, so what the modern targets get from the shared
       framework arrives here as packages.

       Latest 8.0.x patch, for the same reason as the group above: 10.x here
       would drag .NET Framework, Unity and ASP.NET Core 8 consumers onto the
       10.x graph. A Dependabot PR that moved these to 10.0.10 built and tested
       green on all three targets. **CI cannot catch this**, because the harm
       lands on a consumer who does not exist yet. So major bumps are ignored in
       .github/dependabot.yml, while patches and minors flow. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <PackageVersion Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <!-- The real TimeProvider, backported by the same team. Keeps the cache's
         clock abstraction identical on every target instead of forking it
         behind an #if. -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
  </ItemGroup>

  <!-- Benchmark-only. Never shipped: the benchmarks live in their own
       non-packable project, so this never reaches a consumer's dependency
       graph. MIT licensed. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Benchmark-only, to answer whether the deserialization cost is this
         SDK's model shape or its choice of serializer. Newtonsoft.Json is a
         fully independent implementation, not a wrapper over
         System.Text.Json. MIT licensed; never referenced by the SDK, and not
         adoptable anyway since it is not trim- or AOT-safe. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The other public C# TCGdex SDK, referenced only by the benchmark
         project so the comparison runs both through the same stub transport.
         MIT licensed. Never referenced by the SDK itself. -->
    <PackageVersion Include="TCGdex" Version="0.1.0" />
  </ItemGroup>

  <!-- Fuzzing, run on a schedule rather than per push. Instruments the SDK
       assembly and drives it with libFuzzer. MIT licensed, its own
       non-packable project, never shipped. -->
  <ItemGroup>
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <!-- Test-only dependencies. -->
  <ItemGroup>
    <!-- Renders the compiled public surface as C# so a test can compare it to a
         checked-in baseline. This is what Polly and Serilog use; the Roslyn
         PublicApiAnalyzers alternative needs 1,500 entries hand-written with
         nullability annotations and has no supported way to generate them
         outside an IDE. MIT licensed, test-only, never shipped. -->
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!-- Property-based testing: generates thousands of inputs and shrinks a
         failure to its smallest reproducing case. Complements the fuzzers,
         which hunt for crashes on malformed input; these assert that a stated
         property holds across valid input.

         Apache-2.0, test-only, never shipped. Note it ships **only a net8.0
         asset** — no netstandard2.0 — so it is referenced for net8.0 and
         net10.0 and excluded from the net472 leg of the unit suite, the same
         shape as PublicApiGenerator above. -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
  </ItemGroup>

  <!-- Analyzer-only, referenced by the shipped library project alone (see the
       PackageReferences in TcgDex.CSharpSdk.csproj) — not the test or benchmark
       projects, where their rules are near-all noise. PrivateAssets=all there
       keeps them out of any consumer's dependency graph.

       Roslynator.Analyzers and Meziantou.Analyzer added 2026-09-09, per
       PinKushin/ANALYZER-COVERAGE-LOG.md: Roslynator matches what PBJ already
       runs, and Meziantou is a genuine fourth rather than a duplicate — its
       standout categories are async correctness (ConfigureAwait usage, and
       `using` on a Task<IDisposable> disposing the Task rather than the
       awaited result) and culture-sensitive string comparison, neither of
       which Sonar or Roslynator focus on as heavily. This SDK is an async
       HTTP client throughout, which is exactly the shape those rules target.
       See docs/DECISIONS.md for the full record. -->
  <ItemGroup>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
  </ItemGroup>

</Project>
