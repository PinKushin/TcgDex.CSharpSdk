<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies of the SDK, pinned per target framework.

       A library's dependency versions become a floor for every consumer, so
       each target asks for the lowest version that satisfies it rather than the
       newest that exists. A net8.0 app taking a dependency on 10.0.x of these
       would be forced to upgrade its whole Microsoft.Extensions graph — and
       would hit version conflicts against an ASP.NET Core 8 app that pins 8.0.x.
       NuGet resolves upwards on its own, so a consumer already on 10.0.x still
       gets 10.0.x. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0' and '$(TargetFramework)' != 'netstandard2.0'">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

  <!-- netstandard2.0 has no in-box System.Text.Json, no IAsyncEnumerable, and
       no ActivitySource, so what the modern targets get from the shared
       framework arrives here as packages. 8.0.x throughout: it is the newest
       line that still supports netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <PackageVersion Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <!-- The real TimeProvider, backported by the same team. Keeps the cache's
         clock abstraction identical on every target instead of forking it
         behind an #if. -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
  </ItemGroup>

  <!-- Benchmark-only. Never shipped: the benchmarks live in their own
       non-packable project, so this never reaches a consumer's dependency
       graph. MIT licensed. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Benchmark-only, to answer whether the deserialization cost is this
         SDK's model shape or its choice of serializer. Newtonsoft.Json is a
         fully independent implementation, not a wrapper over
         System.Text.Json. MIT licensed; never referenced by the SDK, and not
         adoptable anyway since it is not trim- or AOT-safe. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The other public C# TCGdex SDK, referenced only by the benchmark
         project so the comparison runs both through the same stub transport.
         MIT licensed. Never referenced by the SDK itself. -->
    <PackageVersion Include="TCGdex" Version="0.1.0" />
  </ItemGroup>

  <!-- Test-only dependencies. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
