<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the SDK's targets. The two differ in more than compiler
         symbols: on net10.0 System.Text.Json comes from the shared framework,
         on net8.0 from a package at a different major version. Testing only
         net10.0 would leave the shipped net8.0 assembly build-verified but
         never executed. -->
    <!-- net472 is how the netstandard2.0 assembly gets executed rather than
         merely compiled: .NET Framework resolves that asset, so these runs
         exercise exactly the DLL a Unity or WinForms consumer receives —
         including the init/required shims, which every model relies on.

         Windows only. Running a net472 test assembly elsewhere needs mono, and
         GitHub's ubuntu runners do not have it — vstest aborts the *entire*
         run with "Could not find 'mono' host", taking the net8.0 and net10.0
         results down with it rather than skipping the one framework. The
         Windows CI job is what keeps this framework covered; see ci.yml. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TcgDex.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- CA1707: test names follow {Method}_{Scenario}_{Expected}, so the
         underscores are the convention, not a violation of it.
         CS1591: tests are not public API and carry no XML docs.
         CA1062: tests control their own inputs.
         CA2007: NUnit runs without a synchronization context, so ConfigureAwait
         adds noise without changing behaviour. It stays enforced in the SDK. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1062;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- The public-surface approval test runs on net10.0 only. PublicApiGenerator
       does not support netstandard2.0 or net472 consumers, and package validation
       (DECISIONS #41) already checks that the three assets expose the same API, so
       one baseline covers them. See the PublicApiTests remarks. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="PublicApiGenerator" />
  </ItemGroup>

  <!-- CsCheck 5 ships net10.0 assets and nothing older, so only the net10.0
       leg can reference it (DECISIONS #45). The properties under Properties/
       are statements about pure logic — an LRU that never exceeds its bound —
       and those hold identically on every target, so proving them on one leg
       is enough. The net8.0 and net472 legs exist to execute the net8.0 and
       netstandard2.0 assemblies, which these do not exercise differently. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Properties\**\*.cs" />
  </ItemGroup>

  <!-- The baseline is C# by extension and data by purpose: it describes the
       SDK's surface rather than being part of this project's. Compiling it
       would redeclare every public type in the assembly under test. Kept as a
       .cs file anyway, because that is what makes a diff readable in review. -->
  <ItemGroup>
    <Compile Remove="PublicApi.*.cs" />
    <None Include="PublicApi.approved.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TcgDexTestNetStandard)' != 'true'">
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" />
  </ItemGroup>

  <!-- -p:TcgDexTestNetStandard=true runs the suite against the netstandard2.0 asset instead, on whatever runtime
       the test target is. A net6.0 or net7.0 app resolves that asset and runs it on .NET Core, which the net472
       leg never does (DECISIONS #37 row 19). CI runs it on net10.0. -->
  <!-- Tests that assert what one asset does differently (the handler Create builds, the Microsoft.Extensions line)
       branch on this, as they already do on NETFRAMEWORK. -->
  <PropertyGroup Condition="'$(TcgDexTestNetStandard)' == 'true'">
    <DefineConstants>$(DefineConstants);TCGDEX_NETSTANDARD_ASSET</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TcgDexTestNetStandard)' == 'true'">
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- The reference's packages flow from the library's net10.0 group, not its netstandard2.0 one, so the
         packages a real consumer of that asset receives are listed here (TcgDex.CSharpSdk.csproj). -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <!-- Recorded live-API responses. Contract tests deserialize these so model
       drift is caught offline, without depending on the network. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
