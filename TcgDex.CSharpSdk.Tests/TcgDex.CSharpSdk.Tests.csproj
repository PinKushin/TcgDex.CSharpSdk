<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the SDK's targets. The two differ in more than compiler
         symbols: on net10.0 System.Text.Json comes from the shared framework,
         on net8.0 from a package at a different major version. Testing only
         net10.0 would leave the shipped net8.0 assembly build-verified but
         never executed. -->
    <!-- net472 is how the netstandard2.0 assembly gets executed rather than
         merely compiled: .NET Framework resolves that asset, so these runs
         exercise exactly the DLL a Unity or WinForms consumer receives —
         including the init/required shims, which every model relies on.

         Windows only. Running a net472 test assembly elsewhere needs mono, and
         GitHub's ubuntu runners do not have it — vstest aborts the *entire*
         run with "Could not find 'mono' host", taking the net8.0 and net10.0
         results down with it rather than skipping the one framework. The
         Windows CI job is what keeps this framework covered; see ci.yml. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TcgDex.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- CA1707: test names follow {Method}_{Scenario}_{Expected}, so the
         underscores are the convention, not a violation of it.
         CS1591: tests are not public API and carry no XML docs.
         CA1062: tests control their own inputs.
         CA2007: NUnit runs without a synchronization context, so ConfigureAwait
         adds noise without changing behaviour. It stays enforced in the SDK. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1062;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- The public-surface approval test runs on net10.0 only. PublicApiGenerator
       does not support netstandard2.0 or net472 consumers, and one baseline per
       target framework would mean three files describing overlapping surfaces —
       net10.0 is the richest and a superset, so it catches every change. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="PublicApiGenerator" />
  </ItemGroup>

  <!-- CsCheck ships a net8.0 asset and nothing older, so the net472 leg cannot
       reference it. The properties under Properties/ are statements about pure
       logic — an LRU that never exceeds its bound, an escaper that round-trips
       — and those hold identically on every target, so proving them on the
       modern legs is enough. The net472 leg exists to execute the
       netstandard2.0 assembly, which these do not exercise differently. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="Properties\**\*.cs" />
  </ItemGroup>

  <!-- The baseline is C# by extension and data by purpose: it describes the
       SDK's surface rather than being part of this project's. Compiling it
       would redeclare every public type in the assembly under test. Kept as a
       .cs file anyway, because that is what makes a diff readable in review. -->
  <ItemGroup>
    <Compile Remove="PublicApi.*.cs" />
    <None Include="PublicApi.approved.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" />
  </ItemGroup>

  <!-- Recorded live-API responses. Contract tests deserialize these so model
       drift is caught offline, without depending on the network. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
