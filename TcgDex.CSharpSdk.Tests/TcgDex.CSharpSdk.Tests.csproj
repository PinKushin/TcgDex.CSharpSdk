<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the SDK's targets. The two differ in more than compiler
         symbols: on net10.0 System.Text.Json comes from the shared framework,
         on net8.0 from a package at a different major version. Testing only
         net10.0 would leave the shipped net8.0 assembly build-verified but
         never executed. -->
    <!-- net472 is how the netstandard2.0 assembly gets executed rather than
         merely compiled: .NET Framework resolves that asset, so these runs
         exercise exactly the DLL a Unity or WinForms consumer receives —
         including the init/required shims, which every model relies on.

         Windows only. Running a net472 test assembly elsewhere needs mono, and
         GitHub's ubuntu runners do not have it — vstest aborts the *entire*
         run with "Could not find 'mono' host", taking the net8.0 and net10.0
         results down with it rather than skipping the one framework. The
         Windows CI job is what keeps this framework covered; see ci.yml. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TcgDex.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- CA1707: test names follow {Method}_{Scenario}_{Expected}, so the
         underscores are the convention, not a violation of it.
         CS1591: tests are not public API and carry no XML docs.
         CA1062: tests control their own inputs.
         CA2007: NUnit runs without a synchronization context, so ConfigureAwait
         adds noise without changing behaviour. It stays enforced in the SDK. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1062;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcgDex.CSharpSdk\TcgDex.CSharpSdk.csproj" />
  </ItemGroup>

  <!-- Recorded live-API responses. Contract tests deserialize these so model
       drift is caught offline, without depending on the network. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
